# AgentLens AI Observability - Environment Variables Template
# Copy this file to .env and fill in your credentials

# Google OAuth 2.0 Client ID (from Google Cloud Console -> APIs & Services -> Credentials)
VITE_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=

# Google OAuth 2.0 Client Secret
VITE_GOOGLE_CLIENT_SECRET=
GOOGLE_CLIENT_SECRET=

# Google Gemini AI API Key (from Google AI Studio: https://aistudio.google.com/app/apikey)
# Powers Lens AI Debug Assistant, Root Cause Diagnostics, and Telemetry Queries
VITE_GEMINI_API_KEY=
GEMINI_API_KEY=

# OpenTelemetry Ingestion Endpoint
VITE_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# Application Environment
VITE_APP_ENV=development
APP_ENV=development
